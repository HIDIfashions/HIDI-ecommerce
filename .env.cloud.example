# Cloud development (GitHub Codespaces + Supabase)
# Get DATABASE_URL from Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Redis is not required by the current HIDI commerce core yet.
REDIS_URL=

API_PORT=4000

# Replace these after Codespaces forwards ports 3000 and 4000.
WEB_ORIGIN=https://YOUR-CODESPACE-3000.app.github.dev
API_URL=https://YOUR-CODESPACE-4000.app.github.dev/v1
NEXT_PUBLIC_API_URL=https://YOUR-CODESPACE-4000.app.github.dev/v1

# Same private value in apps/web/.env.local and apps/api/.env
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Razorpay TEST credentials only during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Automated review follow-up (email via Resend)
REVIEW_FOLLOWUP_ENABLED=false
RESEND_API_KEY=
REVIEW_FROM_EMAIL=HIDI <reviews@yourdomain.com>
REVIEW_URL=https://your-domain.com/review
