# Cloud development (GitHub Codespaces + Supabase)
# Get DATABASE_URL from Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Redis is not required by the current HIDI commerce core yet.
REDIS_URL=

API_PORT=4000

# Replace these after Codespaces forwards ports 3000 and 4000.
WEB_ORIGIN=https://YOUR-CODESPACE-3000.app.github.dev
API_URL=https://YOUR-CODESPACE-4000.app.github.dev/v1
NEXT_PUBLIC_API_URL=https://YOUR-CODESPACE-4000.app.github.dev/v1

# Admin RBAC
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# Development / emergency fallback only. Keep false in production.
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_LEGACY_KEY_ENABLED=false

# Customer phone OTP authentication
# Preserve this 32+ character signing secret during provider changes.
HIDI_AUTH_SECRET=replace-with-a-long-random-customer-auth-secret
CUSTOMER_OTP_PROVIDER=msg91
CUSTOMER_OTP_FALLBACK_PROVIDER=firebase
FIREBASE_PROJECT_ID=hidi-dee0f
NEXT_PUBLIC_CUSTOMER_AUTH_PROVIDER=hidi
NEXT_PUBLIC_CUSTOMER_OTP_CHANNEL=sms

# MSG91 SMS OTP: first map the approved DLT header, PE ID and content
# template in MSG91 SendOTP. This is the MSG91 OTP template ID, not the DLT ID.
# Keep MSG91_AUTHKEY server-only.
MSG91_AUTHKEY=
MSG91_SMS_OTP_TEMPLATE_ID=
MSG91_SMS_OTP_ENDPOINT=https://control.msg91.com/api/v5/otp

# Supabase Auth is used for customer identity and passwordless HIDI staff identity.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Razorpay TEST credentials only during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Automated review follow-up (email via Resend)
REVIEW_FOLLOWUP_ENABLED=false
RESEND_API_KEY=
REVIEW_FROM_EMAIL=HIDI <reviews@yourdomain.com>
REVIEW_URL=https://your-domain.com/review

# Public HIDI WhatsApp ordering number, digits only with country code (example India: 9198XXXXXXXX)
NEXT_PUBLIC_HIDI_WHATSAPP_NUMBER=

# Consent-aware retention foundation: disabled by default; no outbound sender exists.
# API flag (apps/api/.env)
RETENTION_ENABLED=false
# Browser flag (apps/web/.env.local); requires a rebuild when changed.
NEXT_PUBLIC_RETENTION_ENABLED=false

# Read-only rewards estimates, not a spendable wallet (API only).
HIDI_REWARDS_PREVIEW_ENABLED=false
# Set only after approving the return-window policy (whole days, 1-365).
HIDI_REWARD_RETURN_WINDOW_DAYS=7

# Real wallet, disabled until staging acceptance. API only.
# Confirmed: 7 days after delivery; no percentage redemption cap.
# Implemented earning basis and partial-return terms still need publication.
HIDI_WALLET_ENABLED=false
# Optional once-per-minute maturity worker; run on a continuously running API.
HIDI_WALLET_WORKER_ENABLED=false
# Browser wallet controls (apps/web/.env.local); rebuild when changed.
NEXT_PUBLIC_WALLET_ENABLED=false
