# API settings. Keep disabled until the exact live-image candidate and provider
# callback have been verified. Do not paste secret values into Git or chat.
WHATSAPP_CHATBOT_ENABLED=false
WHATSAPP_CHATBOT_PROVIDER=msg91
WHATSAPP_CHATBOT_START_AT=
WHATSAPP_CHATBOT_TEST_NUMBERS=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_AUTHKEY=
MSG91_WHATSAPP_WEBHOOK_TOKEN=
# Existing MSG91_AUTHKEY is used if the dedicated WhatsApp key is absent.
# Existing WEB_ORIGIN must start with the public HTTPS storefront origin.
# Storefront build setting: same approved business number, international digits.
NEXT_PUBLIC_HIDI_WHATSAPP_NUMBER=
