# Local development
DATABASE_URL=postgresql://hidi:hidi_local_password@localhost:5432/hidi?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Canonical public storefront URL used by metadata, robots and sitemap.
# Set this to the final production domain without a path.
SITE_URL=https://your-domain.com
# Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=

# Admin RBAC
# One-time verified email allowed to create the first OWNER when AdminStaff is empty.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# Legacy development / break-glass key. Keep disabled in production after the first OWNER is active.
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_LEGACY_KEY_ENABLED=false

# Customer phone OTP authentication
# Use a 32+ character secret; rotating it signs everyone out.
HIDI_AUTH_SECRET=replace-with-a-long-random-customer-auth-secret
HIDI_AUTH_ACCESS_TTL_SECONDS=3600
HIDI_AUTH_REFRESH_TTL_SECONDS=2592000
CUSTOMER_OTP_PROVIDER=firebase
NEXT_PUBLIC_CUSTOMER_AUTH_PROVIDER=firebase

# Firebase Phone Auth. Browser keys are public; keep HIDI_AUTH_SECRET server-only.
FIREBASE_PROJECT_ID=
FIREBASE_TENANT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional WhatsApp OTP sender if CUSTOMER_OTP_PROVIDER=whatsapp.
WHATSAPP_OTP_PROVIDER=meta
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_AUTH_TEMPLATE_NAME=hidi_signin_otp
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US
WHATSAPP_AUTH_TEMPLATE_INCLUDE_BUTTON=true
# Local-only bypass. Never enable in production.
HIDI_AUTH_DEV_OTP=false
HIDI_AUTH_DEV_OTP_RESPONSE=false

# Optional Twilio WhatsApp OTP sender if WHATSAPP_OTP_PROVIDER=twilio.
TWILIO_WHATSAPP_OTP_CONTENT_SID=
TWILIO_WHATSAPP_BODY_OTP_ENABLED=false

# Supabase staff/admin authentication fallback (publishable key is safe for browser use)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Razorpay: use TEST keys locally, LIVE keys only in production secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production media infrastructure
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Automated review follow-up (email via Resend)
REVIEW_FOLLOWUP_ENABLED=false
RESEND_API_KEY=
REVIEW_FROM_EMAIL=HIDI <reviews@yourdomain.com>
REVIEW_URL=https://your-domain.com/review

# Public HIDI WhatsApp ordering number, digits only with country code (example India: 9198XXXXXXXX)
NEXT_PUBLIC_HIDI_WHATSAPP_NUMBER=

# Consent-aware retention foundation: disabled by default; no outbound sender exists.
# API flag (apps/api/.env)
RETENTION_ENABLED=false
# Browser flag (apps/web/.env.local); requires a rebuild when changed.
NEXT_PUBLIC_RETENTION_ENABLED=false

# Read-only rewards estimates, not a spendable wallet (API only).
HIDI_REWARDS_PREVIEW_ENABLED=false
# Set only after approving the return-window policy (whole days, 1-365).
HIDI_REWARD_RETURN_WINDOW_DAYS=7

# Real wallet, disabled until staging acceptance. API only.
# Confirmed: 7 days after delivery; no percentage redemption cap.
# Implemented earning basis and partial-return terms still need publication.
HIDI_WALLET_ENABLED=false
# Optional once-per-minute maturity worker; run on a continuously running API.
HIDI_WALLET_WORKER_ENABLED=false
# Browser wallet controls (apps/web/.env.local); rebuild when changed.
NEXT_PUBLIC_WALLET_ENABLED=false


# WhatsApp chatbot / Twilio WhatsApp Business Platform
WHATSAPP_CHATBOT_ENABLED=false
# Keep true outside isolated local testing.
WHATSAPP_TWILIO_SIGNATURE_VALIDATION=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exact public webhook URL configured in Twilio, e.g. https://api.example.com/v1/whatsapp/webhook
TWILIO_WHATSAPP_WEBHOOK_URL=
# WhatsApp-enabled Twilio sender in E.164 format, e.g. +14155238886 for Sandbox
TWILIO_WHATSAPP_FROM=
# Optional approved Content SIDs for proactive templates outside the 24-hour service window
TWILIO_WHATSAPP_ORDER_UPDATE_CONTENT_SID=
TWILIO_WHATSAPP_MARKETING_CONTENT_SID=


# HIDI social profiles shown in the footer (optional until profiles are live)
NEXT_PUBLIC_HIDI_INSTAGRAM_URL=
NEXT_PUBLIC_HIDI_FACEBOOK_URL=
NEXT_PUBLIC_HIDI_X_URL=
NEXT_PUBLIC_HIDI_YOUTUBE_URL=
