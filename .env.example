# Local development
DATABASE_URL=postgresql://hidi:hidi_local_password@localhost:5432/hidi?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Same private value in apps/web/.env.local and apps/api/.env
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Supabase customer authentication (publishable key is safe for browser use)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Razorpay: use TEST keys locally, LIVE keys only in production secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production media infrastructure
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Automated review follow-up (email via Resend)
REVIEW_FOLLOWUP_ENABLED=false
RESEND_API_KEY=
REVIEW_FROM_EMAIL=HIDI <reviews@yourdomain.com>
REVIEW_URL=https://your-domain.com/review

# Public HIDI WhatsApp ordering number, digits only with country code (example India: 9198XXXXXXXX)
NEXT_PUBLIC_HIDI_WHATSAPP_NUMBER=
