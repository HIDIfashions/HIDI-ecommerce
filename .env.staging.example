# HIDI staging environment template
# Copy values into the hosting providers' secret/environment-variable settings.
# Never commit real secrets.

# Environment identity
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging

# Public URLs
WEB_ORIGIN=https://staging.your-domain.com
API_URL=https://api-staging.your-domain.com/v1
NEXT_PUBLIC_API_URL=https://api-staging.your-domain.com/v1

# Railway injects PORT automatically. Do not hard-code PORT in hosted environments.
API_PORT=4000

# Supabase / PostgreSQL
# For a persistent API service, use the Supabase Session pooler connection string unless
# your networking setup supports a direct connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Admin access
ADMIN_API_KEY=replace-with-a-long-random-staging-admin-key

# Razorpay staging: TEST MODE ONLY
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-test-webhook-secret

# Product media
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Review follow-up
REVIEW_FOLLOWUP_ENABLED=false
RESEND_API_KEY=
REVIEW_FROM_EMAIL=HIDI <reviews@your-domain.com>
REVIEW_URL=https://staging.your-domain.com/review

# Public WhatsApp ordering
NEXT_PUBLIC_HIDI_WHATSAPP_NUMBER=

# Retention / outbound marketing stays disabled during initial staging
RETENTION_ENABLED=false
NEXT_PUBLIC_RETENTION_ENABLED=false

# Rewards / wallet staging validation
HIDI_REWARDS_PREVIEW_ENABLED=true
HIDI_REWARD_RETURN_WINDOW_DAYS=7
HIDI_WALLET_ENABLED=true
HIDI_WALLET_WORKER_ENABLED=true
NEXT_PUBLIC_WALLET_ENABLED=true

# WhatsApp automation remains disabled until its own staging acceptance
WHATSAPP_CHATBOT_ENABLED=false
WHATSAPP_TWILIO_SIGNATURE_VALIDATION=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_ORDER_UPDATE_CONTENT_SID=
TWILIO_WHATSAPP_MARKETING_CONTENT_SID=

# Social profiles
NEXT_PUBLIC_HIDI_INSTAGRAM_URL=
NEXT_PUBLIC_HIDI_FACEBOOK_URL=
NEXT_PUBLIC_HIDI_X_URL=
NEXT_PUBLIC_HIDI_YOUTUBE_URL=
