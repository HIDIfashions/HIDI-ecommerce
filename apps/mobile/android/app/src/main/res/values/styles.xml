<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:navigationBarColor">#FAF8F4</item>
        <item name="android:statusBarColor">#FAF8F4</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.HIDI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#702B42</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hidi_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
