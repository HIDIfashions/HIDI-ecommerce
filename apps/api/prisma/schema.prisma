generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  OPERATIONS
  SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  PAYMENT_REVIEW
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  CORRECTION
  DAMAGE
  RETURN_RESTOCK
  OTHER
}

enum StockReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum VendorInvoiceStatus {
  UPLOADED
  MAPPING
  AWAITING_STOCK
  PARTIALLY_RECEIVED
  RECEIVED
  RECONCILED
  CANCELLED
}

enum InvoiceBreakupSource {
  EXPLICIT_INVOICE
  PACK_PATTERN
  MANUAL
}

enum CustomerInvoiceStatus {
  ISSUED
  VOIDED
  CREDITED
}

enum ReviewFollowUpStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReviewFollowUpChannel {
  EMAIL
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  firstName     String?
  lastName      String?
  role          UserRole @default(CUSTOMER)
  marketingOptIn Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  couponUses    CouponRedemption[]
  retentionProfile RetentionProfile?
  wallet        WalletAccount?

  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  firstName   String
  lastName    String?
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  countryCode String   @default("IN")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postalCode])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  categoryId     String?
  name           String
  internalCode   String        @unique
  slug           String        @unique
  shortDescription String?
  description    String?
  fabric         String?
  care           String?
  status         ProductStatus @default(DRAFT)
  featuredRank   Int           @default(9999)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  cartItems      CartItem[]
  collections    ProductCollection[]
  vendorMappings VendorProduct[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([status, featuredRank])
  @@index([categoryId, status])
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  active      Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  sku         String    @unique
  size        String
  color       String
  colorHex    String?
  mrpPaise    Int
  pricePaise  Int
  active      Boolean   @default(true)
  weightGrams Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ProductVariantImage[]
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reservations InventoryReservation[]
  stockReceiptLines StockReceiptLine[]
  vendorPackEntries VendorPackPattern[]
  invoiceExpectations VendorInvoiceExpectedVariant[]
  stockLots StockLot[]
  stockAllocations OrderStockAllocation[]
  adminMediaUploadTickets AdminMediaUploadTicket[]

  @@unique([productId, size, color])
  @@index([productId, active])
}

model AdminMediaUploadTicket {
  id         String         @id @default(cuid())
  tokenHash  String         @unique
  variantId  String
  mimeType   String
  maxBytes   Int
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime       @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, expiresAt])
  @@index([expiresAt, usedAt])
}

model ProductVariantImage {
  id          String         @id @default(cuid())
  variantId   String
  url         String
  storagePath String?
  alt         String
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, url])
  @@index([variantId, position])
}

model Inventory {
  id           String              @id @default(cuid())
  variantId    String              @unique
  onHand       Int                 @default(0)
  reserved     Int                 @default(0)
  safetyStock  Int                 @default(0)
  reorderLevel Int                 @default(5)
  updatedAt    DateTime            @updatedAt
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
}

model InventoryMovement {
  id           String                @id @default(cuid())
  inventoryId  String
  type         InventoryMovementType
  delta        Int
  onHandBefore Int
  onHandAfter  Int
  reason       String
  note         String?
  reference    String?
  actor        String?
  createdAt    DateTime              @default(now())
  inventory    Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([createdAt])
}

model StockReceipt {
  id                  String             @id @default(cuid())
  receiptNumber       String             @unique
  supplierName        String
  invoiceNumber       String?
  purchaseOrderNumber String?
  vendorInvoiceId     String?
  purchaseOrderId     String?
  receivedAt          DateTime
  status              StockReceiptStatus @default(DRAFT)
  note                String?
  totalAccepted       Int                @default(0)
  totalRejected       Int                @default(0)
  createdBy           String?
  postedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lines               StockReceiptLine[]
  vendorInvoice       VendorInvoice?      @relation(fields: [vendorInvoiceId], references: [id], onDelete: SetNull)
  purchaseOrder       PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([receivedAt])
  @@index([vendorInvoiceId, receivedAt])
  @@index([purchaseOrderId, receivedAt])
}

model StockReceiptLine {
  id               String         @id @default(cuid())
  receiptId           String
  variantId           String
  vendorInvoiceLineId String?
  acceptedQuantity    Int
  rejectedQuantity Int            @default(0)
  unitCostPaise    Int?
  createdAt        DateTime       @default(now())
  receipt          StockReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant          ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  vendorInvoiceLine VendorInvoiceLine? @relation(fields: [vendorInvoiceLineId], references: [id], onDelete: SetNull)
  stockLots        StockLot[]

  @@unique([receiptId, variantId])
  @@index([variantId])
  @@index([vendorInvoiceLineId])
}

model Vendor {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  normalizedName  String          @unique
  gstin           String?
  city            String?
  state           String?
  contactName     String?
  phone           String?
  email           String?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  products        VendorProduct[]
  invoices        VendorInvoice[]
  purchaseOrders  PurchaseOrder[]

  @@index([name])
  @@index([active, name])
}

model VendorProduct {
  id                String              @id @default(cuid())
  vendorId          String
  productId         String
  vendorStyleCode   String
  hidiStyleCode     String?
  vendorProductName String?
  hsn               String?
  defaultUnitCostPaise Int?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  vendor            Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  packPattern       VendorPackPattern[]
  invoiceLines      VendorInvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([vendorId, vendorStyleCode])
  @@index([productId])
  @@index([hidiStyleCode])
  @@index([vendorId, active])
}

model VendorPackPattern {
  id              String         @id @default(cuid())
  vendorProductId String
  variantId       String
  quantity        Int
  position        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  vendorProduct   VendorProduct  @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([vendorProductId, variantId])
  @@index([variantId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  poNumber       String              @unique
  vendorId       String
  orderDate      DateTime
  expectedAt     DateTime?
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("INR")
  note           String?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines          PurchaseOrderLine[]
  receipts       StockReceipt[]
  invoices       VendorInvoice[]

  @@index([vendorId, orderDate])
  @@index([status, orderDate])
}

model PurchaseOrderLine {
  id              String         @id @default(cuid())
  purchaseOrderId String
  lineNumber      Int
  vendorProductId String?
  productId       String
  vendorStyleCode String
  description     String?
  orderedQuantity Int
  unitCostPaise   Int?
  hsn             String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorProduct   VendorProduct? @relation(fields: [vendorProductId], references: [id], onDelete: SetNull)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNumber])
  @@index([vendorProductId])
  @@index([productId])
}

model VendorInvoice {
  id                String              @id @default(cuid())
  vendorId          String
  invoiceNumber     String
  invoiceDate       DateTime
  purchaseReference String?
  purchaseOrderId   String?
  originalFilename  String?
  documentUrl       String?
  rawText           String?
  status            VendorInvoiceStatus @default(UPLOADED)
  subtotalPaise     Int?
  taxPaise          Int?
  totalPaise        Int?
  note              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  vendor            Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines             VendorInvoiceLine[]
  receipts          StockReceipt[]
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([vendorId, invoiceNumber])
  @@index([status, invoiceDate])
  @@index([vendorId, invoiceDate])
  @@index([purchaseOrderId, invoiceDate])
}

model VendorInvoiceLine {
  id                String         @id @default(cuid())
  vendorInvoiceId   String
  vendorProductId   String?
  rawDescription    String
  vendorStyleCode   String?
  hsn               String?
  invoiceQuantity   Int
  unitCostPaise     Int?
  amountPaise       Int?
  breakupSource     InvoiceBreakupSource?
  mappingConfirmed  Boolean        @default(false)
  note              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vendorInvoice     VendorInvoice  @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)
  vendorProduct     VendorProduct? @relation(fields: [vendorProductId], references: [id], onDelete: SetNull)
  expectedVariants  VendorInvoiceExpectedVariant[]
  receiptLines      StockReceiptLine[]
  stockLots         StockLot[]

  @@index([vendorInvoiceId])
  @@index([vendorProductId])
  @@index([vendorStyleCode])
}

model VendorInvoiceExpectedVariant {
  id             String                @id @default(cuid())
  invoiceLineId  String
  variantId      String
  expectedQuantity Int
  source         InvoiceBreakupSource
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  invoiceLine    VendorInvoiceLine     @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([invoiceLineId, variantId])
  @@index([variantId])
}

model StockLot {
  id                  String             @id @default(cuid())
  lotCode             String             @unique
  receiptLineId       String
  variantId           String
  vendorInvoiceLineId String?
  acceptedQuantity    Int
  allocatedQuantity   Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  receiptLine         StockReceiptLine   @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  vendorInvoiceLine   VendorInvoiceLine? @relation(fields: [vendorInvoiceLineId], references: [id], onDelete: SetNull)
  allocations         OrderStockAllocation[]

  @@index([variantId, createdAt])
  @@index([vendorInvoiceLineId])
}

model CustomerInvoice {
  id             String                @id @default(cuid())
  orderId        String                @unique
  invoiceNumber  String                @unique
  status         CustomerInvoiceStatus @default(ISSUED)
  issuedAt       DateTime              @default(now())
  subtotalPaise  Int
  discountPaise  Int
  shippingPaise  Int
  taxPaise       Int
  totalPaise     Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([issuedAt])
}

model OrderStockAllocation {
  id          String         @id @default(cuid())
  orderId     String
  orderItemId String
  variantId   String
  stockLotId  String
  quantity    Int
  scanPayload String?
  createdAt   DateTime       @default(now())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockLot    StockLot       @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, stockLotId])
  @@index([orderId])
  @@index([variantId])
  @@index([stockLotId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  currency  String     @default("INR")
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int            @default(1)
  unitPricePaise Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  status        OrderStatus @default(PENDING_PAYMENT)
  currency      String      @default("INR")
  subtotalPaise Int
  discountPaise Int         @default(0)
  shippingPaise Int         @default(0)
  taxPaise      Int         @default(0)
  totalPaise    Int
  walletAppliedPaise Int    @default(0)
  customerEmail String?
  customerPhone String
  shippingAddress Json
  billingAddress  Json?
  notes         String?
  checkoutToken String?      @unique
  cartSessionId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  reservations  InventoryReservation[]
  reviewFollowUps ReviewFollowUp[]
  reviews         ProductReview[]
  walletHold      WalletHold?
  rewardAccrual   RewardAccrual?
  walletEntries   WalletLedger[]
  returnRequests  ReturnRequest[]
  auditEvents     OrderAuditEvent[]
  customerInvoice CustomerInvoice?
  stockAllocations OrderStockAllocation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([cartSessionId])
}

model OrderAuditEvent {
  id            String   @id @default(cuid())
  orderId       String
  eventType     String
  actorType     String
  actorId       String?
  entityType    String?
  entityId      String?
  fromStatus    String?
  toStatus      String?
  amountPaise   Int?
  eventKey      String?  @unique
  correlationId String?
  source        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
  @@index([eventType, createdAt])
  @@index([correlationId])
}

model ReviewFollowUp {
  id                String                @id @default(cuid())
  orderId           String
  channel           ReviewFollowUpChannel @default(EMAIL)
  status            ReviewFollowUpStatus  @default(PENDING)
  dueAt             DateTime
  sentAt            DateTime?
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  lastError         String?
  providerMessageId String?
  reviewToken       String?               @unique
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, channel])
  @@index([status, dueAt])
  @@index([orderId])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  orderId          String
  orderItemId      String    @unique
  rating           Int
  title            String?
  body             String
  reviewerName     String
  verifiedPurchase Boolean   @default(true)
  published        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, published, createdAt])
  @@index([orderId])
}
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String
  sku            String
  size           String
  color          String
  quantity       Int
  unitPricePaise Int
  discountPaise  Int            @default(0)
  totalPaise     Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  review         ProductReview?
  returnRequests ReturnRequest[]
  stockAllocations OrderStockAllocation[]

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
}


model InventoryReservation {
  id         String            @id @default(cuid())
  orderId    String
  variantId  String
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime          @default(now())
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("RAZORPAY")
  providerOrderId   String?
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  amountPaise       Int
  method            String?
  rawReference      Json?
  refunds           PaymentRefund[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([providerOrderId])
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String
  provider        String?
  providerOrderId String?
  awb             String?        @unique
  trackingUrl     String?
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  active        Boolean  @default(true)
  discountType  String
  discountValue Int
  minOrderPaise Int      @default(0)
  maxDiscountPaise Int?
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  perUserLimit  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
  @@index([userId])
}

// Backend-only retention data. Browser/Data API access is denied by the migration.
model RetentionProfile {
  id                    String   @id @default(cuid())
  authSubject           String   @unique
  userId                String   @unique
  whatsappOptIn         Boolean  @default(false)
  personalizationOptIn  Boolean  @default(false)
  consentVersion        String   @default("hidi-retention-v1")
  verifiedPhone         String?
  phoneVerifiedAt       DateTime?
  consentUpdatedAt      DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits                RetentionConsentAudit[]
  events                RetentionEvent[]
  deliveries            RetentionDelivery[]
}

model RetentionConsentAudit {
  id                    String   @id @default(cuid())
  profileId             String
  whatsappOptIn         Boolean
  personalizationOptIn  Boolean
  consentVersion        String
  source                String
  verifiedPhone         String?
  createdAt             DateTime @default(now())
  profile               RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model RetentionEvent {
  id         String   @id @default(cuid())
  profileId  String
  productId  String
  variantId  String?
  kind       String
  episodeKey String
  createdAt  DateTime @default(now())
  profile    RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, productId, createdAt])
  @@index([createdAt])
}

model RetentionDelivery {
  id         String   @id @default(cuid())
  profileId  String
  episodeKey String   @unique
  kind       String
  category   String   @default("MARKETING")
  status     String
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  profile    RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category, sentAt])
}

// Server-only store credit. No client/Data API writes or transferable balances.
model WalletAccount {
  id            String   @id @default(cuid())
  authSubject   String   @unique
  userId        String   @unique
  currency      String   @default("INR")
  balancePaise  Int      @default(0)
  reservedPaise Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries       WalletLedger[]
  holds         WalletHold[]
  accruals      RewardAccrual[]
}

model WalletLedger {
  id         String   @id @default(cuid())
  walletId   String
  orderId    String?
  kind       String
  deltaPaise Int
  eventKey   String   @unique
  createdAt  DateTime @default(now())
  wallet     WalletAccount @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt, id])
  @@index([orderId])
}

model WalletHold {
  id           String   @id @default(cuid())
  walletId     String
  orderId      String   @unique
  amountPaise  Int
  status       String   @default("ACTIVE")
  expiresAt    DateTime
  consumedAt   DateTime?
  releasedAt   DateTime?
  refundedAt   DateTime?
  createdAt    DateTime @default(now())
  wallet       WalletAccount @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@index([status, expiresAt])
}

model RewardAccrual {
  id               String   @id @default(cuid())
  walletId         String
  orderId          String   @unique
  basisPaise       Int
  rewardPaise      Int
  returnWindowDays Int
  policyVersion   String
  status          String   @default("PENDING")
  eligibleAt      DateTime?
  creditedAt      DateTime?
  reversedAt      DateTime?
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wallet          WalletAccount @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@index([status, eligibleAt, id])
  @@index([createdAt, id])
}

model PaymentRefund {
  id               String   @id @default(cuid())
  paymentId        String
  providerRefundId String   @unique
  amountPaise      Int
  status          String   @default("PROCESSED")
  processedAt     DateTime
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
}


model WhatsAppConversation {
  id            String            @id @default(cuid())
  phone         String            @unique
  state         String            @default("IDLE")
  context       Json?
  lastInboundAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      WhatsAppMessage[]

  @@index([state, updatedAt])
}

model WhatsAppMessage {
  id                 String               @id @default(cuid())
  conversationId     String
  providerMessageSid String               @unique
  direction          String
  body               String
  status             String               @default("RECEIVED")
  createdAt          DateTime             @default(now())
  conversation       WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}


model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("ACTIVE")
  source         String   @default("FOOTER")
  consentVersion String   @default("hidi-newsletter-v1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}


model ReturnRequest {
  id                       String    @id @default(cuid())
  orderId                  String
  orderItemId              String
  type                     String
  reason                   String
  detail                   String?
  quantity                 Int       @default(1)
  refundDestination        String?
  requestedVariantId       String?
  requestedSize            String?
  refundPaise              Int       @default(0)
  status                   String    @default("REQUESTED")
  adminNote                String?
  rejectionReason          String?
  pickupProvider           String?
  pickupAwb                String?
  pickupTrackingUrl        String?
  pickupScheduledAt        DateTime?
  receivedAt               DateTime?
  inventoryDisposition     String?
  refundWalletPaise        Int       @default(0)
  refundCashPaise          Int       @default(0)
  refundStatus             String?
  refundProviderId         String?   @unique
  replacementProvider      String?
  replacementAwb           String?
  replacementTrackingUrl   String?
  replacementShippedAt     DateTime?
  exchangeReservationStatus String?
  exchangeReservedAt       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  approvedAt               DateTime?
  processedAt              DateTime?
  completedAt              DateTime?
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem                OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId, status, createdAt])
  @@index([orderItemId, status])
  @@index([status, updatedAt])
}
