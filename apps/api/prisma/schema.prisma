generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  OPERATIONS
  SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  PAYMENT_REVIEW
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  CORRECTION
  DAMAGE
  RETURN_RESTOCK
  OTHER
}

enum StockReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ReviewFollowUpStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReviewFollowUpChannel {
  EMAIL
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  firstName     String?
  lastName      String?
  role          UserRole @default(CUSTOMER)
  marketingOptIn Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  couponUses    CouponRedemption[]
  retentionProfile RetentionProfile?

  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  firstName   String
  lastName    String?
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  countryCode String   @default("IN")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postalCode])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  categoryId     String?
  name           String
  slug           String        @unique
  shortDescription String?
  description    String?
  fabric         String?
  care           String?
  status         ProductStatus @default(DRAFT)
  featuredRank   Int           @default(9999)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  cartItems      CartItem[]
  collections    ProductCollection[]

  @@index([status, featuredRank])
  @@index([categoryId, status])
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  active      Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  sku         String    @unique
  size        String
  color       String
  colorHex    String?
  mrpPaise    Int
  pricePaise  Int
  active      Boolean   @default(true)
  weightGrams Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  images      ProductVariantImage[]
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reservations InventoryReservation[]
  stockReceiptLines StockReceiptLine[]

  @@unique([productId, size, color])
  @@index([productId, active])
}

model ProductVariantImage {
  id          String         @id @default(cuid())
  variantId   String
  url         String
  storagePath String?
  alt         String
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, url])
  @@index([variantId, position])
}

model Inventory {
  id           String              @id @default(cuid())
  variantId    String              @unique
  onHand       Int                 @default(0)
  reserved     Int                 @default(0)
  safetyStock  Int                 @default(0)
  reorderLevel Int                 @default(5)
  updatedAt    DateTime            @updatedAt
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
}

model InventoryMovement {
  id           String                @id @default(cuid())
  inventoryId  String
  type         InventoryMovementType
  delta        Int
  onHandBefore Int
  onHandAfter  Int
  reason       String
  note         String?
  reference    String?
  actor        String?
  createdAt    DateTime              @default(now())
  inventory    Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([createdAt])
}

model StockReceipt {
  id                  String             @id @default(cuid())
  receiptNumber       String             @unique
  supplierName        String
  invoiceNumber       String?
  purchaseOrderNumber String?
  receivedAt          DateTime
  status              StockReceiptStatus @default(DRAFT)
  note                String?
  totalAccepted       Int                @default(0)
  totalRejected       Int                @default(0)
  createdBy           String?
  postedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lines               StockReceiptLine[]

  @@index([status, createdAt])
  @@index([receivedAt])
}

model StockReceiptLine {
  id               String         @id @default(cuid())
  receiptId        String
  variantId        String
  acceptedQuantity Int
  rejectedQuantity Int            @default(0)
  unitCostPaise    Int?
  createdAt        DateTime       @default(now())
  receipt          StockReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([receiptId, variantId])
  @@index([variantId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  currency  String     @default("INR")
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int            @default(1)
  unitPricePaise Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String?
  status        OrderStatus @default(PENDING_PAYMENT)
  currency      String      @default("INR")
  subtotalPaise Int
  discountPaise Int         @default(0)
  shippingPaise Int         @default(0)
  taxPaise      Int         @default(0)
  totalPaise    Int
  customerEmail String?
  customerPhone String
  shippingAddress Json
  billingAddress  Json?
  notes         String?
  checkoutToken String?      @unique
  cartSessionId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  reservations  InventoryReservation[]
  reviewFollowUps ReviewFollowUp[]
  reviews         ProductReview[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([cartSessionId])
}

model ReviewFollowUp {
  id                String                @id @default(cuid())
  orderId           String
  channel           ReviewFollowUpChannel @default(EMAIL)
  status            ReviewFollowUpStatus  @default(PENDING)
  dueAt             DateTime
  sentAt            DateTime?
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  lastError         String?
  providerMessageId String?
  reviewToken       String?               @unique
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, channel])
  @@index([status, dueAt])
  @@index([orderId])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  orderId          String
  orderItemId      String    @unique
  rating           Int
  title            String?
  body             String
  reviewerName     String
  verifiedPurchase Boolean   @default(true)
  published        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, published, createdAt])
  @@index([orderId])
}
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String
  sku            String
  size           String
  color          String
  quantity       Int
  unitPricePaise Int
  discountPaise  Int            @default(0)
  totalPaise     Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  review         ProductReview?

  @@index([orderId])
  @@index([variantId])
}


model InventoryReservation {
  id         String            @id @default(cuid())
  orderId    String
  variantId  String
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime          @default(now())
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("RAZORPAY")
  providerOrderId   String?
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  amountPaise       Int
  method            String?
  rawReference      Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([providerOrderId])
}

model Shipment {
  id              String         @id @default(cuid())
  orderId         String
  provider        String?
  providerOrderId String?
  awb             String?        @unique
  trackingUrl     String?
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  active        Boolean  @default(true)
  discountType  String
  discountValue Int
  minOrderPaise Int      @default(0)
  maxDiscountPaise Int?
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  perUserLimit  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
}

// Backend-only retention data. Browser/Data API access is denied by the migration.
model RetentionProfile {
  id                    String   @id @default(cuid())
  authSubject           String   @unique
  userId                String   @unique
  whatsappOptIn         Boolean  @default(false)
  personalizationOptIn  Boolean  @default(false)
  consentVersion        String   @default("hidi-retention-v1")
  verifiedPhone         String?
  phoneVerifiedAt       DateTime?
  consentUpdatedAt      DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits                RetentionConsentAudit[]
  events                RetentionEvent[]
  deliveries            RetentionDelivery[]
}

model RetentionConsentAudit {
  id                    String   @id @default(cuid())
  profileId             String
  whatsappOptIn         Boolean
  personalizationOptIn  Boolean
  consentVersion        String
  source                String
  verifiedPhone         String?
  createdAt             DateTime @default(now())
  profile               RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model RetentionEvent {
  id         String   @id @default(cuid())
  profileId  String
  productId  String
  variantId  String?
  kind       String
  episodeKey String
  createdAt  DateTime @default(now())
  profile    RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, productId, createdAt])
  @@index([createdAt])
}

model RetentionDelivery {
  id         String   @id @default(cuid())
  profileId  String
  episodeKey String   @unique
  kind       String
  category   String   @default("MARKETING")
  status     String
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  profile    RetentionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, category, sentAt])
}
