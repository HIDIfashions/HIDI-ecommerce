{
  "name": "HIDI Commerce",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "3000": {
      "label": "HIDI Storefront",
      "onAutoForward": "openBrowser"
    },
    "4000": {
      "label": "HIDI API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.15.1 --activate && pnpm install",
  "remoteUser": "node"
}
