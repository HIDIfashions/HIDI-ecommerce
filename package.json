{
  "name": "hidi-commerce",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @hidi/web --filter @hidi/api dev",
    "dev:web": "pnpm --filter @hidi/web dev",
    "dev:api": "pnpm --filter @hidi/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @hidi/api prisma:generate",
    "db:migrate": "pnpm --filter @hidi/api prisma:migrate",
    "db:seed": "pnpm --filter @hidi/api prisma:seed",
    "build:web:clean": "bash scripts/build-web-clean.sh"
  }
}
